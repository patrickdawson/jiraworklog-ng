{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "mocha", "@wdio/globals/types", "@wdio/mocha-framework"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
